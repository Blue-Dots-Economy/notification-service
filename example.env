SERVER_PORT=`SERVER_PORT`
# Required. NS refuses to start without it.
REDIS_PASSWORD=`REDIS_PASSWORD`
# Local runs / CI only: set to true to allow an unauthenticated Redis. Never in a deployment.
#REDIS_ALLOW_NO_AUTH=true
# Postgres — required. NS records every send and refuses to start without it.
DATABASE_HOST=`DATABASE_HOST`
DATABASE_PORT=5432
DATABASE_NAME=notification
DATABASE_USER=notification
DATABASE_PASSWORD=`DATABASE_PASSWORD`
# disable | require
DATABASE_SSL=disable
INTERNAL_SECRETS_JSON=/app/config/internal-secrets.json
#SMS — which vendor this deployment sends through: `msg91` (default) or `pinnacle`.
# One vendor per deployment. Both register as channel `sms`, so no caller changes.
SMS_PROVIDER=`SMS_PROVIDER`

#SMS Services (MSG91 Flow API)
MSG91_AUTH_KEY=`MSG91_AUTH_KEY`
# MSG91 flow id for the legacy `login_otp` template. Optional — falls back to a
# built-in default if unset. Per-event DLT flow ids are sent raw and need no env.
SMS_LOGIN_OTP_TEMPLATE_ID=`SMS_LOGIN_OTP_TEMPLATE_ID`

#SMS Services (Pinnacle — only read when SMS_PROVIDER=pinnacle)
# Pinnacle does NOT render templates: it takes final text plus the DLT ids the
# operator matches on. So it needs both an id AND a body for every template.
PINNACLE_API_KEY=`PINNACLE_API_KEY`
# Registered DLT header. 6 alpha characters, or numeric.
PINNACLE_SENDER_ID=`PINNACLE_SENDER_ID`
# DLT principal-entity id — one per adopter, issued by the DLT platform.
PINNACLE_DLT_ENTITY_ID=`PINNACLE_DLT_ENTITY_ID`
# Optional DLT fields; omitted from the request when unset.
PINNACLE_DLT_HEADER_ID=`PINNACLE_DLT_HEADER_ID`
PINNACLE_DLT_TAG_ID=`PINNACLE_DLT_TAG_ID`
PINNACLE_TMID=`PINNACLE_TMID`
# Pinnacle's DLT template id for `login_otp`. Blank until the approval lands —
# a blank id dead-letters the job with an explicit "not configured yet" message.
PINNACLE_LOGIN_OTP_TEMPLATE_ID=`PINNACLE_LOGIN_OTP_TEMPLATE_ID`
# The `login_otp` body, used by providers that cannot render. Must be
# BYTE-IDENTICAL to the DLT-approved text or the operator scrubs the message.
# `{{message}}` is the OTP code — the variable every OTP caller already sends.
SMS_LOGIN_OTP_BODY=`SMS_LOGIN_OTP_BODY`
# How often the worker refreshes the Pinnacle balance gauge (ms, default 15min).
BALANCE_POLL_INTERVAL_MS=`BALANCE_POLL_INTERVAL_MS`
# Whatsapp Service (twilio)
TWILIO_WHATSAPP_NUMBER=`TWILIO_WHATSAPP_NUMBER`
TWILIO_MESSAGING_SERVICE_SID=`TWILIO_MESSAGING_SERVICE_SID`
TWILIO_AUTH_TOKEN=`TWILIO_AUTH_TOKEN`
TWILIO_ACCOUNT_SID=`TWILIO_ACCOUNT_SID`
TWILIO_CONTENT_SID_DIALFLOW_PROVIDER=`TWILIO_CONTENT_SID_DIALFLOW_PROVIDER`
SEND_WHATSAPP_NOTIFICATION=`SEND_WHATSAPP_NOTIFICATION`

#Email Services
MAIL_LOG=`MAIL_LOG`
# Attachment limits for channel=email. Total decoded bytes across all
# attachments in one notify request (default 5242880 = 5MB) and how many files
# it may carry (default 3). Must be >= the caller's own cap, or the caller's
# oversized submissions are rejected here with a 400.
NOTIFY_ATTACHMENT_MAX_TOTAL_BYTES=`NOTIFY_ATTACHMENT_MAX_TOTAL_BYTES`
NOTIFY_ATTACHMENT_MAX_FILES=`NOTIFY_ATTACHMENT_MAX_FILES`
# Optional HTTP body-limit override. Unset = derived from the attachment budget
# (base64 inflation + envelope headroom), which is what you normally want.
NOTIFY_BODY_LIMIT_BYTES=`NOTIFY_BODY_LIMIT_BYTES`

#AWS
SMTP_AWS_SES=`SMTP_AWS_SES`
AWS_SECRET_ACCESS_KEY=`AWS_SECRET_ACCESS_KEY`
AWS_ACCESS_KEY_ID=`AWS_ACCESS_KEY_ID`
AWS_REGION=`AWS_REGION`

#SMTP (any provider: Zoho, Mailgun, a corporate relay, an SES SMTP endpoint)
# SMTP_HOST selects this transport. Port defaults to 587, SMTP_SECURE to true only on 465.
SMTP_HOST=`SMTP_HOST`
SMTP_PORT=`SMTP_PORT`
SMTP_SECURE=`SMTP_SECURE`
SMTP_USER=`SMTP_USER`
SMTP_PASS=`SMTP_PASS`
# Fixed envelope sender. Optional — unset means the caller's `fromEmail` is used.
SMTP_FROM=`SMTP_FROM`
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_PASS=App Password.

#Feature Flags
LOG_ACTIVITY=`LOG_ACTIVITY`

# Template and policy admin API
# The network this deployment serves. Required for /v1/admin/* and boot seeding.
NS_NETWORK=`NS_NETWORK`
# Fallback locale for template resolution (default en).
NS_DEFAULT_LOCALE=`NS_DEFAULT_LOCALE`
# Comma-separated HMAC key ids allowed to use /v1/admin/*. Unset means nobody can.
NS_ADMIN_KEY_IDS=`NS_ADMIN_KEY_IDS`

# Worker pools: loops per priority, each on its own Redis connection (positive integers).
WORKER_URGENT_CONCURRENCY=`WORKER_URGENT_CONCURRENCY`
WORKER_NORMAL_CONCURRENCY=`WORKER_NORMAL_CONCURRENCY`
WORKER_BULK_CONCURRENCY=`WORKER_BULK_CONCURRENCY`
# Vendor quota per channel (tokens/sec and burst). Defaults: sms 100/40, email 100/50, whatsapp 100/10.
RATE_SMS_PER_SEC=`RATE_SMS_PER_SEC`
RATE_SMS_BURST=`RATE_SMS_BURST`
RATE_EMAIL_PER_SEC=`RATE_EMAIL_PER_SEC`
RATE_EMAIL_BURST=`RATE_EMAIL_BURST`
RATE_WHATSAPP_PER_SEC=`RATE_WHATSAPP_PER_SEC`
RATE_WHATSAPP_BURST=`RATE_WHATSAPP_BURST`
# Share of the quota reserved for urgent sends (0 < share < 1, default 0.2).
RATE_URGENT_SHARE=`RATE_URGENT_SHARE`
# Wait before a rate-limited job is tried again (ms, default 250, plus up to 50% jitter).
RATE_LIMIT_DEFER_MS=`RATE_LIMIT_DEFER_MS`
# Cap on every vendor call, including SMTP/SES and the Pinnacle balance poll (ms, default 10000).
PROVIDER_TIMEOUT_MS=`PROVIDER_TIMEOUT_MS`
# Seconds an urgent (OTP) job stays sendable before it expires unsent (default 600).
URGENT_DEFAULT_DEADLINE_S=`URGENT_DEFAULT_DEADLINE_S`
