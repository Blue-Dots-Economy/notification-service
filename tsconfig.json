{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "lib": [
      "ES2020"
    ],
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": [
      "node"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ],
    "paths": {
      "src/*": [
        "./src/*"
      ]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    // Tests live beside the code under src/, so without these they would be
    // compiled into dist/ and shipped in the image. They are also written for
    // vitest's ESM transform (top-level await around vi.mock), which tsc's
    // CommonJS emit rejects. `pnpm test` is what checks them; `pnpm build`
    // should only ever produce runtime code.
    "**/*.test.ts",
    "src/**/__tests__/**"
  ]
}
